import os, sqlite3, secrets, re
from datetime import datetime, timedelta
from functools import wraps
from pathlib import Path
from flask import Flask, request, redirect, url_for, session, flash, abort, render_template_string, send_file
from werkzeug.security import generate_password_hash, check_password_hash

try:
 import psycopg
 from psycopg.rows import dict_row
 from psycopg import IntegrityError as PGIntegrityError
except ImportError:
 psycopg = None
 dict_row = None
 PGIntegrityError = Exception

class PGRow(dict):
 def __getitem__(self, key):
  if isinstance(key, int):
   return list(self.values())[key]
  return super().__getitem__(key)

class PGCursorCompat:
 def __init__(self, cursor):
  self._cursor=cursor
  self.lastrowid=None
 def _convert(self, row):
  if row is None: return None
  if isinstance(row, dict): return PGRow(row)
  cols=[d.name if hasattr(d,'name') else d[0] for d in self._cursor.description]
  return PGRow(zip(cols,row))
 def fetchone(self): return self._convert(self._cursor.fetchone())
 def fetchall(self): return [self._convert(r) for r in self._cursor.fetchall()]
 def __getattr__(self,name): return getattr(self._cursor,name)

APP='CLINIQUE MUGHULUNGU'
BASE=Path(__file__).resolve().parent
DB=Path(os.getenv('CLINIQUE_DB_PATH', BASE/'clinique_mughulungu.db'))
DATABASE_URL=os.getenv('CLINIQUE_DATABASE_URL','').strip()
ROLES=['Administrateur','Réceptionniste','Médecin','Infirmier','Pharmacien','Comptable','Direction']
app=Flask(__name__)
app.config.update(SECRET_KEY=os.getenv('CLINIQUE_SECRET_KEY',secrets.token_hex(32)),SESSION_COOKIE_HTTPONLY=True,SESSION_COOKIE_SAMESITE='Lax',PERMANENT_SESSION_LIFETIME=timedelta(minutes=30))

def is_postgres():
 return bool(DATABASE_URL)

def _sql(sql):
 if not is_postgres(): return sql
 sql=sql.replace('INSERT OR IGNORE INTO','INSERT INTO')
 sql=re.sub(r"date\('now'\)", 'CURRENT_DATE', sql, flags=re.I)
 return sql.replace('?', '%s')

class PGConn:
 def __init__(self):
  if psycopg is None: raise RuntimeError('psycopg est requis lorsque CLINIQUE_DATABASE_URL est configuré.')
  self.c=psycopg.connect(DATABASE_URL, row_factory=dict_row)
 def execute(self,sql,params=()):
  sql=_sql(sql)
  upper=sql.lstrip().upper()
  if upper.startswith('INSERT INTO') and 'ON CONFLICT' not in upper and any(t in sql.lower() for t in ('roles','permissions','role_permissions')):
   sql += ' ON CONFLICT DO NOTHING'
  m=re.match(r'INSERT\s+INTO\s+([A-Za-z_][A-Za-z0-9_]*)',sql,re.I)
  if m and m.group(1).lower() != 'role_permissions' and 'RETURNING' not in upper:
   sql += ' RETURNING id'
  cur=PGCursorCompat(self.c.execute(sql, params))
  if m and m.group(1).lower() != 'role_permissions':
   row=cur.fetchone()
   cur.lastrowid = row['id'] if row is not None and 'id' in row else None
  return cur
 def commit(self): self.c.commit()
 def rollback(self): self.c.rollback()
 def close(self): self.c.close()

def con():
 if is_postgres(): return PGConn()
 c=sqlite3.connect(DB); c.row_factory=sqlite3.Row; c.execute('PRAGMA foreign_keys=ON'); return c
def now(): return datetime.now().strftime('%Y-%m-%d %H:%M:%S')
def init_db():
 if not is_postgres():
  DB.parent.mkdir(parents=True,exist_ok=True); c=con()
  c.executescript('''
 CREATE TABLE IF NOT EXISTS roles(id INTEGER PRIMARY KEY,name TEXT UNIQUE NOT NULL);
 CREATE TABLE IF NOT EXISTS permissions(id INTEGER PRIMARY KEY,name TEXT UNIQUE NOT NULL,module TEXT NOT NULL);
 CREATE TABLE IF NOT EXISTS role_permissions(role_id INTEGER NOT NULL,permission_id INTEGER NOT NULL,PRIMARY KEY(role_id,permission_id),FOREIGN KEY(role_id) REFERENCES roles(id) ON DELETE CASCADE,FOREIGN KEY(permission_id) REFERENCES permissions(id) ON DELETE CASCADE);
 CREATE TABLE IF NOT EXISTS users(id INTEGER PRIMARY KEY,username TEXT UNIQUE NOT NULL,password_hash TEXT NOT NULL,role_id INTEGER NOT NULL,is_active INTEGER NOT NULL DEFAULT 1,failed_attempts INTEGER NOT NULL DEFAULT 0,locked_until TEXT,created_at TEXT NOT NULL,updated_at TEXT NOT NULL,FOREIGN KEY(role_id) REFERENCES roles(id));
 CREATE TABLE IF NOT EXISTS audit_logs(id INTEGER PRIMARY KEY,user_id INTEGER,action TEXT NOT NULL,module TEXT NOT NULL,date_time TEXT NOT NULL,object_type TEXT,object_id INTEGER,result TEXT NOT NULL,FOREIGN KEY(user_id) REFERENCES users(id));
 CREATE TABLE IF NOT EXISTS patients(id INTEGER PRIMARY KEY,patient_number TEXT UNIQUE NOT NULL,last_name TEXT NOT NULL,post_name TEXT,first_name TEXT NOT NULL,sex TEXT NOT NULL,birth_date TEXT,birth_place TEXT,address TEXT,phone TEXT,profession TEXT,admin_info TEXT,created_at TEXT NOT NULL,updated_at TEXT NOT NULL);
 CREATE TABLE IF NOT EXISTS patient_contacts(id INTEGER PRIMARY KEY,patient_id INTEGER NOT NULL,name TEXT NOT NULL,relationship TEXT,phone TEXT,FOREIGN KEY(patient_id) REFERENCES patients(id) ON DELETE CASCADE);
 CREATE TABLE IF NOT EXISTS appointments(id INTEGER PRIMARY KEY,patient_id INTEGER NOT NULL,doctor_id INTEGER,service TEXT,appointment_date TEXT NOT NULL,appointment_time TEXT NOT NULL,reason TEXT,status TEXT NOT NULL DEFAULT 'Prévu',created_at TEXT NOT NULL,updated_at TEXT NOT NULL,FOREIGN KEY(patient_id) REFERENCES patients(id),FOREIGN KEY(doctor_id) REFERENCES users(id));
 CREATE TABLE IF NOT EXISTS triage_records(id INTEGER PRIMARY KEY,patient_id INTEGER NOT NULL,temperature REAL,weight REAL,blood_pressure TEXT,heart_rate REAL,respiratory_rate REAL,oxygen_saturation REAL,height REAL,bmi REAL,pain_scale INTEGER,observation TEXT,recorded_by INTEGER,recorded_at TEXT NOT NULL,FOREIGN KEY(patient_id) REFERENCES patients(id));
 CREATE TABLE IF NOT EXISTS medical_records(id INTEGER PRIMARY KEY,patient_id INTEGER UNIQUE NOT NULL,created_at TEXT NOT NULL,updated_at TEXT NOT NULL,FOREIGN KEY(patient_id) REFERENCES patients(id));
 CREATE TABLE IF NOT EXISTS consultations(id INTEGER PRIMARY KEY,patient_id INTEGER NOT NULL,medical_record_id INTEGER NOT NULL,doctor_id INTEGER NOT NULL,consultation_date TEXT NOT NULL,complaint TEXT,history TEXT,temperature REAL,weight REAL,blood_pressure TEXT,heart_rate REAL,respiratory_rate REAL,oxygen_saturation REAL,clinical_exam TEXT,primary_diagnosis TEXT,secondary_diagnosis TEXT,hypotheses TEXT,treatment TEXT,advice TEXT,next_appointment TEXT,referral TEXT,hospitalization_needed INTEGER NOT NULL DEFAULT 0,created_at TEXT NOT NULL,FOREIGN KEY(patient_id) REFERENCES patients(id),FOREIGN KEY(medical_record_id) REFERENCES medical_records(id),FOREIGN KEY(doctor_id) REFERENCES users(id));
 CREATE TABLE IF NOT EXISTS prescriptions(id INTEGER PRIMARY KEY,patient_id INTEGER NOT NULL,consultation_id INTEGER,prescribed_by INTEGER NOT NULL,prescription_date TEXT NOT NULL,instructions TEXT,FOREIGN KEY(patient_id) REFERENCES patients(id),FOREIGN KEY(consultation_id) REFERENCES consultations(id),FOREIGN KEY(prescribed_by) REFERENCES users(id));
 CREATE TABLE IF NOT EXISTS prescription_items(id INTEGER PRIMARY KEY,prescription_id INTEGER NOT NULL,medicine_id INTEGER,medicine_name TEXT NOT NULL,dosage TEXT,frequency TEXT,duration TEXT,instructions TEXT,FOREIGN KEY(prescription_id) REFERENCES prescriptions(id) ON DELETE CASCADE,FOREIGN KEY(medicine_id) REFERENCES medicines(id));
 CREATE TABLE IF NOT EXISTS laboratory_requests(id INTEGER PRIMARY KEY,patient_id INTEGER NOT NULL,prescriber_id INTEGER NOT NULL,exam_requested TEXT NOT NULL,sample TEXT,request_date TEXT NOT NULL,FOREIGN KEY(patient_id) REFERENCES patients(id),FOREIGN KEY(prescriber_id) REFERENCES users(id));
 CREATE TABLE IF NOT EXISTS laboratory_results(id INTEGER PRIMARY KEY,laboratory_request_id INTEGER NOT NULL,result TEXT,conclusion TEXT,result_date TEXT NOT NULL,recorded_by INTEGER,FOREIGN KEY(laboratory_request_id) REFERENCES laboratory_requests(id) ON DELETE CASCADE,FOREIGN KEY(recorded_by) REFERENCES users(id));
 CREATE TABLE IF NOT EXISTS hospitalizations(id INTEGER PRIMARY KEY,hospitalization_number TEXT UNIQUE NOT NULL,patient_id INTEGER NOT NULL,doctor_id INTEGER NOT NULL,service TEXT,entry_datetime TEXT NOT NULL,reason TEXT,diagnosis TEXT,room_bed TEXT,treatment TEXT,observations TEXT,discharge_datetime TEXT,final_diagnosis TEXT,recommendations TEXT,FOREIGN KEY(patient_id) REFERENCES patients(id),FOREIGN KEY(doctor_id) REFERENCES users(id));
 CREATE TABLE IF NOT EXISTS hospitalization_observations(id INTEGER PRIMARY KEY,hospitalization_id INTEGER NOT NULL,observation_datetime TEXT NOT NULL,temperature REAL,blood_pressure TEXT,pulse REAL,weight REAL,patient_state TEXT,treatment TEXT,nurse_observation TEXT,recorded_by INTEGER,FOREIGN KEY(hospitalization_id) REFERENCES hospitalizations(id));
 CREATE TABLE IF NOT EXISTS medicine_categories(id INTEGER PRIMARY KEY,name TEXT UNIQUE NOT NULL);
 CREATE TABLE IF NOT EXISTS suppliers(id INTEGER PRIMARY KEY,name TEXT UNIQUE NOT NULL,phone TEXT,address TEXT,contact_person TEXT);
 CREATE TABLE IF NOT EXISTS medicines(id INTEGER PRIMARY KEY,code TEXT UNIQUE NOT NULL,name TEXT NOT NULL,form TEXT,dosage TEXT,category TEXT,supplier TEXT,purchase_price REAL NOT NULL DEFAULT 0,sale_price REAL NOT NULL DEFAULT 0,available_quantity REAL NOT NULL DEFAULT 0,minimum_threshold REAL NOT NULL DEFAULT 0,expiration_date TEXT,lot_number TEXT,created_at TEXT NOT NULL,updated_at TEXT NOT NULL);
 CREATE TABLE IF NOT EXISTS stock_movements(id INTEGER PRIMARY KEY,medicine_id INTEGER NOT NULL,movement_type TEXT NOT NULL,quantity REAL NOT NULL,unit_price REAL,reference TEXT,user_id INTEGER NOT NULL,movement_date TEXT NOT NULL,FOREIGN KEY(medicine_id) REFERENCES medicines(id));
 CREATE TABLE IF NOT EXISTS inventory(id INTEGER PRIMARY KEY,inventory_date TEXT NOT NULL,medicine_id INTEGER NOT NULL,theoretical_quantity REAL NOT NULL,counted_quantity REAL NOT NULL,difference REAL NOT NULL,user_id INTEGER NOT NULL,FOREIGN KEY(medicine_id) REFERENCES medicines(id));
 CREATE TABLE IF NOT EXISTS invoices(id INTEGER PRIMARY KEY,patient_id INTEGER,invoice_number TEXT UNIQUE NOT NULL,reason TEXT NOT NULL,amount REAL NOT NULL,status TEXT NOT NULL DEFAULT 'À payer',created_at TEXT NOT NULL);
 CREATE TABLE IF NOT EXISTS payments(id INTEGER PRIMARY KEY,invoice_id INTEGER,patient_id INTEGER,amount REAL NOT NULL,payment_mode TEXT NOT NULL,reason TEXT,user_id INTEGER NOT NULL,payment_date TEXT NOT NULL);
 CREATE TABLE IF NOT EXISTS expenses(id INTEGER PRIMARY KEY,reason TEXT NOT NULL,amount REAL NOT NULL,supplier TEXT,user_id INTEGER NOT NULL,expense_date TEXT NOT NULL);
 CREATE TABLE IF NOT EXISTS cash_transactions(id INTEGER PRIMARY KEY,transaction_type TEXT NOT NULL,amount REAL NOT NULL,reason TEXT NOT NULL,user_id INTEGER NOT NULL,transaction_date TEXT NOT NULL);
 CREATE TABLE IF NOT EXISTS discharges(id INTEGER PRIMARY KEY,patient_id INTEGER NOT NULL,hospitalization_id INTEGER,diagnosis TEXT,evolution TEXT,treatment TEXT,recommendations TEXT,discharge_date TEXT NOT NULL,user_id INTEGER,FOREIGN KEY(patient_id) REFERENCES patients(id),FOREIGN KEY(hospitalization_id) REFERENCES hospitalizations(id));
 CREATE TABLE IF NOT EXISTS referrals(id INTEGER PRIMARY KEY,patient_id INTEGER NOT NULL,destination TEXT NOT NULL,reason TEXT,clinical_summary TEXT,recommendations TEXT,referral_date TEXT NOT NULL,user_id INTEGER,FOREIGN KEY(patient_id) REFERENCES patients(id));
 CREATE TABLE IF NOT EXISTS follow_ups(id INTEGER PRIMARY KEY,patient_id INTEGER NOT NULL,care_type TEXT,observation TEXT,evolution TEXT,follow_up_date TEXT NOT NULL,user_id INTEGER,FOREIGN KEY(patient_id) REFERENCES patients(id));
  ''')
 else:
  c=con()
 for r in ROLES:c.execute('INSERT OR IGNORE INTO roles(name) VALUES(?)',(r,))
 for name,module in [('patients.view','Réception'),('patients.manage','Réception'),('appointments.manage','Réception'),('triage.manage','Réception'),('consultations.manage','Consultation'),('hospitalizations.manage','Consultation'),('laboratory.manage','Consultation'),('pharmacy.manage','Pharmacie'),('accounting.manage','Comptabilité'),('reports.view','Administration'),('users.manage','Administration'),('audit.view','Administration')]: c.execute('INSERT OR IGNORE INTO permissions(name,module) VALUES(?,?)',(name,module))
 permission_map={
  'Administrateur':['patients.view','patients.manage','appointments.manage','triage.manage','consultations.manage','hospitalizations.manage','laboratory.manage','pharmacy.manage','accounting.manage','reports.view','users.manage','audit.view'],
  'Réceptionniste':['patients.view','patients.manage','appointments.manage','triage.manage'],
  'Médecin':['patients.view','consultations.manage','hospitalizations.manage','laboratory.manage','pharmacy.manage'],
  'Infirmier':['patients.view','consultations.manage','hospitalizations.manage','laboratory.manage'],
  'Pharmacien':['patients.view','pharmacy.manage'],
  'Comptable':['accounting.manage'],
  'Direction':['patients.view','appointments.manage','triage.manage','consultations.manage','hospitalizations.manage','laboratory.manage','pharmacy.manage','accounting.manage','reports.view']
 }
 for role,perms in permission_map.items():
  rid=c.execute('SELECT id FROM roles WHERE name=?',(role,)).fetchone()['id']
  for perm_name in perms:
   perm=c.execute('SELECT id FROM permissions WHERE name=?',(perm_name,)).fetchone()
   if perm: c.execute('INSERT OR IGNORE INTO role_permissions(role_id,permission_id) VALUES(?,?)',(rid,perm['id']))
 if c.execute('SELECT COUNT(*) n FROM users').fetchone()['n']==0:
  rid=c.execute("SELECT id FROM roles WHERE name='Administrateur'").fetchone()['id']; t=now()
  c.execute('INSERT INTO users(username,password_hash,role_id,created_at,updated_at) VALUES(?,?,?,?,?)',('admin',generate_password_hash('ChangeMe-Admin-2026!'),rid,t,t))
 c.commit(); c.close()
init_db()

def user():
 if not session.get('uid'): return None
 c=con(); u=c.execute('SELECT u.*,r.name role FROM users u JOIN roles r ON r.id=u.role_id WHERE u.id=?',(session['uid'],)).fetchone(); c.close(); return u
def write_audit(action,module,result='SUCCÈS',typ=None,oid=None):
 c=con(); c.execute('INSERT INTO audit_logs(user_id,action,module,date_time,object_type,object_id,result) VALUES(?,?,?,?,?,?,?)',(session.get('uid'),action,module,now(),typ,oid,result)); c.commit(); c.close()
def csrf():
 session.setdefault('csrf',secrets.token_urlsafe(32)); return session['csrf']
@app.context_processor
def ctx(): return {'user':user(),'csrf':csrf(),'app':APP}
@app.before_request
def guards():
 if session.get('uid'):
  if session.get('last') and datetime.now()-datetime.fromisoformat(session['last'])>timedelta(minutes=30): session.clear(); flash('Session expirée.','warning'); return redirect(url_for('login'))
  session['last']=datetime.now().isoformat(timespec='seconds')
  if not user(): session.clear(); return redirect(url_for('login'))
 if request.method=='POST' and request.endpoint!='login' and request.form.get('_csrf')!=session.get('csrf'): abort(400)
@app.after_request
def headers(r): r.headers.update({'X-Content-Type-Options':'nosniff','X-Frame-Options':'SAMEORIGIN','Referrer-Policy':'strict-origin-when-cross-origin','Cache-Control':'no-store'}); return r
def roles(*allowed):
 def deco(f):
  @wraps(f)
  def w(*a,**k):
   u=user()
   if not u:return redirect(url_for('login'))
   if u['role'] not in allowed:write_audit('ACCÈS REFUSÉ',request.endpoint,'REFUS');abort(403)
   return f(*a,**k)
  return w
 return deco

def page(title,body,**data):
 shell='''<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{title}} — {{app}}</title><style>body{font-family:Arial;margin:0;background:#f4f6f8;color:#20252b}header{background:#123b5d;color:#fff;padding:14px 22px;display:flex;justify-content:space-between}nav{background:#173f61;padding:8px 14px;display:flex;gap:6px;flex-wrap:wrap}nav a{color:#fff;text-decoration:none;background:#245579;padding:7px 9px;border-radius:4px;font-size:13px}main{max-width:1280px;margin:20px auto;padding:0 14px}.card{background:#fff;padding:16px;border:1px solid #dce2e7;border-radius:7px;margin-bottom:15px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}.formgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px}label{display:block;font-weight:bold;margin:5px 0}input,select,textarea{width:100%;box-sizing:border-box;padding:8px;border:1px solid #cbd3da;border-radius:4px}textarea{min-height:75px}button,.btn{background:#145a86;color:#fff;border:0;border-radius:4px;padding:9px 13px;text-decoration:none;cursor:pointer}table{width:100%;border-collapse:collapse}th,td{border:1px solid #ddd;padding:7px}th{background:#edf1f4}.stat{font-size:26px;font-weight:bold}.small{font-size:12px;color:#65717a}.alert{padding:9px;margin:8px 0;border-radius:4px;background:#e5edf4}.danger{background:#f7d5d5}.success{background:#dcefe0}.warning{background:#fff0bf}</style></head><body><header><div><b>{{app}}</b><div class="small" style="color:#dce8f0">Gestion médicale, administrative, pharmaceutique et comptable</div></div><div>{% if user %}{{user.username}} — {{user.role}}{% endif %}</div></header>{% if user %}<nav><a href="{{url_for('dashboard')}}">Tableau de bord</a>{% if user.role in ['Administrateur','Réceptionniste','Direction'] %}<a href="{{url_for('patients')}}">Patients</a><a href="{{url_for('appointments')}}">Rendez-vous</a><a href="{{url_for('triage')}}">Triage</a>{% endif %}{% if user.role in ['Administrateur','Médecin','Infirmier','Direction'] %}<a href="{{url_for('consultations')}}">Consultation</a><a href="{{url_for('hospitalizations')}}">Hospitalisation</a><a href="{{url_for('hospitalization_observations')}}">Suivi hospitalier</a><a href="{{url_for('laboratory')}}">Laboratoire</a><a href="{{url_for('prescriptions')}}">Prescriptions</a><a href="{{url_for('medical_forms')}}">Formulaires médicaux</a>{% endif %}{% if user.role in ['Administrateur','Pharmacien','Médecin','Direction'] %}<a href="{{url_for('pharmacy')}}">Pharmacie</a><a href="{{url_for('inventory')}}">Inventaire</a>{% endif %}{% if user.role in ['Administrateur','Comptable','Direction'] %}<a href="{{url_for('accounting')}}">Comptabilité</a>{% endif %}{% if user.role in ['Administrateur','Direction'] %}<a href="{{url_for('reports')}}">Rapports</a>{% endif %}{% if user.role=='Administrateur' %}<a href="{{url_for('administration')}}">Administration</a><a href="{{url_for('audit')}}">Audit</a><a href="{{url_for('backup')}}">Sauvegarde</a>{% endif %}<a href="{{url_for('logout')}}">Déconnexion</a></nav>{% endif %}<main>{% with ms=get_flashed_messages(with_categories=true) %}{% for c,m in ms %}<div class="alert {{c}}">{{m}}</div>{% endfor %}{% endwith %}'''+body+'</main></body></html>'
 return render_template_string(shell,title=title,**data)

LOGIN='''<div class="card" style="max-width:420px;margin:70px auto"><h2>Connexion sécurisée</h2><form method="post"><label>Nom d'utilisateur</label><input name="username" required><label>Mot de passe</label><input name="password" type="password" required><input type="hidden" name="_csrf" value="{{csrf}}"><br><button>Se connecter</button></form><p class="small">Compte initial : admin / ChangeMe-Admin-2026! — à changer avant usage réel.</p></div>'''
@app.route('/login',methods=['GET','POST'])
def login():
 if request.method=='POST':
  c=con(); u=c.execute('SELECT u.*,r.name role FROM users u JOIN roles r ON r.id=u.role_id WHERE username=?',(request.form.get('username','').strip(),)).fetchone()
  if not u: c.close(); flash('Identifiants invalides.','danger'); return render_template_string(LOGIN)
  if not u['is_active']: c.close(); flash('Compte désactivé.','danger'); return render_template_string(LOGIN)
  if u['locked_until'] and datetime.now()<datetime.fromisoformat(u['locked_until']): c.close(); flash('Compte temporairement verrouillé.','danger'); return render_template_string(LOGIN)
  if not check_password_hash(u['password_hash'],request.form.get('password','')):
   n=u['failed_attempts']+1; lock=(datetime.now()+timedelta(minutes=10)).isoformat(timespec='seconds') if n>=5 else None; n=0 if lock else n;c.execute('UPDATE users SET failed_attempts=?,locked_until=? WHERE id=?',(n,lock,u['id']));c.commit();c.close();flash('Identifiants invalides.','danger');return render_template_string(LOGIN)
  c.execute('UPDATE users SET failed_attempts=0,locked_until=NULL,updated_at=? WHERE id=?',(now(),u['id']));c.commit();c.close();session.clear();session.permanent=True;session['uid']=u['id'];session['last']=datetime.now().isoformat(timespec='seconds');session['csrf']=secrets.token_urlsafe(32);write_audit('CONNEXION','AUTHENTIFICATION');return redirect(url_for('dashboard'))
 return render_template_string(LOGIN)
@app.route('/logout')
def logout():
 if user():write_audit('DÉCONNEXION','AUTHENTIFICATION')
 session.clear();return redirect(url_for('login'))
@app.route('/')
def index():return redirect(url_for('dashboard') if user() else url_for('login'))
@app.route('/dashboard')
@roles(*ROLES)
def dashboard():
 c=con(); s={'patients':c.execute('SELECT COUNT(*) FROM patients').fetchone()[0],'consultations':c.execute("SELECT COUNT(*) FROM consultations WHERE consultation_date=date('now')").fetchone()[0],'hospitalisations':c.execute('SELECT COUNT(*) FROM hospitalizations WHERE discharge_datetime IS NULL').fetchone()[0],'rendez_vous':c.execute("SELECT COUNT(*) FROM appointments WHERE appointment_date=date('now')").fetchone()[0],'revenus_jour':c.execute("SELECT COALESCE(SUM(amount),0) FROM payments WHERE date(payment_date)=date('now')").fetchone()[0],'depenses_jour':c.execute("SELECT COALESCE(SUM(amount),0) FROM expenses WHERE date(expense_date)=date('now')").fetchone()[0],'stocks_faibles':c.execute('SELECT COUNT(*) FROM medicines WHERE available_quantity<=minimum_threshold').fetchone()[0]};c.close()
 body='''<h1>Tableau de bord</h1><div class="grid">{% for k,v in stats.items() %}<div class="card"><div class="small">{{k.replace('_',' ')|upper}}</div><div class="stat">{{v}}</div></div>{% endfor %}</div>''';return page('Tableau de bord',body,stats=s)

@app.route('/patients',methods=['GET','POST'])
@roles('Administrateur','Réceptionniste','Direction')
def patients():
 c=con()
 if request.method=='POST':
  try:
   t=now()

   # Génération automatique du numéro patient
   last=c.execute(
    "SELECT patient_number FROM patients WHERE patient_number LIKE ? ORDER BY id DESC LIMIT 1",
    ('PAT%',)
   ).fetchone()

   if last and last['patient_number']:
    try:
     num=int(last['patient_number'].replace('PAT',''))
    except ValueError:
     num=0
   else:
    num=0

   patient_number=f'PAT{num+1:06d}'

   cur=c.execute(
    'INSERT INTO patients(patient_number,last_name,post_name,first_name,sex,birth_date,birth_place,address,phone,profession,admin_info,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)',
    (
     patient_number,
     request.form['last_name'],
     request.form.get('post_name'),
     request.form['first_name'],
     request.form['sex'],
     request.form.get('birth_date') or None,
     request.form.get('birth_place'),
     request.form.get('address'),
     request.form.get('phone'),
     request.form.get('profession'),
     request.form.get('admin_info'),
     t,
     t
    )
   )

   pid=cur.lastrowid

   c.execute(
    'INSERT INTO medical_records(patient_id,created_at,updated_at) VALUES(?,?,?)',
    (pid,t,t)
   )

   c.commit()
   write_audit('CRÉATION PATIENT','RÉCEPTION','SUCCÈS','patients',pid)
   flash(f'Patient {patient_number} enregistré.','success')

  except (sqlite3.IntegrityError, PGIntegrityError):
   c.rollback()
   flash('Impossible d’enregistrer le patient. Vérifiez les données saisies.','danger')

 rows=c.execute(
  'SELECT * FROM patients ORDER BY id DESC LIMIT 200'
 ).fetchall()

 c.close()

