</div>

</div>
<br>
<button>Enregistrer le patient</button>
</form>
</div>

<div class="card">
<table>
<tr>
<th>N°</th>
<th>Identité</th>
<th>Sexe</th>
<th>Naissance</th>
<th>Téléphone</th>
</tr>

{% for p in rows %}
<tr>
<td>{{p.patient_number}}</td>
<td>{{p.last_name}} {{p.post_name or ''}} {{p.first_name}}</td>
<td>{{p.sex}}</td>
<td>{{p.birth_date or ''}}</td>
<td>{{p.phone or ''}}</td>
</tr>
{% endfor %}

</table>
</div>'''

 return page('Patients',body,rows=rows)

@app.route('/appointments',methods=['GET','POST'])
@roles('Administrateur','Réceptionniste','Direction')
def appointments():
 c=con()
 if request.method=='POST':
  cur=c.execute('INSERT INTO appointments(patient_id,doctor_id,service,appointment_date,appointment_time,reason,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?)',(request.form['patient_id'],request.form.get('doctor_id') or None,request.form.get('service'),request.form['appointment_date'],request.form['appointment_time'],request.form.get('reason'),now(),now()));c.commit();write_audit('CRÉATION RENDEZ-VOUS','RÉCEPTION','SUCCÈS','appointments',cur.lastrowid);flash('Rendez-vous enregistré.','success')
 pats=c.execute('SELECT id,patient_number,last_name,first_name FROM patients ORDER BY last_name').fetchall();docs=c.execute("SELECT u.id,u.username FROM users u JOIN roles r ON r.id=u.role_id WHERE r.name='Médecin' AND u.is_active=TRUE").fetchall();rows=c.execute('SELECT a.*,p.patient_number,p.last_name,p.first_name,u.username doctor FROM appointments a JOIN patients p ON p.id=a.patient_id LEFT JOIN users u ON u.id=a.doctor_id ORDER BY a.id DESC LIMIT 200').fetchall();c.close()
 body='''<h1>Rendez-vous</h1><div class="card"><form method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="formgrid"><div><label>Patient</label><select name="patient_id" required>{% for p in pats %}<option value="{{p.id}}">{{p.patient_number}} — {{p.last_name}} {{p.first_name}}</option>{% endfor %}</select></div><div><label>Médecin</label><select name="doctor_id"><option value="">Non précisé</option>{% for d in docs %}<option value="{{d.id}}">{{d.username}}</option>{% endfor %}</select></div><div><label>Service</label><input name="service"></div><div><label>Date</label><input name="appointment_date" type="date" required></div><div><label>Heure</label><input name="appointment_time" type="time" required></div><div><label>Motif</label><input name="reason"></div></div><br><button>Enregistrer</button></form></div><div class="card"><table><tr><th>Date</th><th>Patient</th><th>Médecin</th><th>Service</th><th>Motif</th><th>Statut</th></tr>{% for a in rows %}<tr><td>{{a.appointment_date}} {{a.appointment_time}}</td><td>{{a.patient_number}} — {{a.last_name}} {{a.first_name}}</td><td>{{a.doctor or ''}}</td><td>{{a.service or ''}}</td><td>{{a.reason or ''}}</td><td>{{a.status}}</td></tr>{% endfor %}</table></div>'''
 return page('Rendez-vous',body,pats=pats,docs=docs,rows=rows)

@app.route('/triage',methods=['GET','POST'])
@roles('Administrateur','Réceptionniste','Infirmier','Médecin','Direction')
def triage():
 c=con()
 if request.method=='POST':
  h=request.form.get('height');w=request.form.get('weight');bmi=round(float(w)/((float(h)/100)**2),2) if h and w and float(h)>0 else None
  cur=c.execute('INSERT INTO triage_records(patient_id,temperature,weight,blood_pressure,heart_rate,respiratory_rate,oxygen_saturation,height,bmi,pain_scale,observation,recorded_by,recorded_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)',(request.form['patient_id'],request.form.get('temperature') or None,w,request.form.get('blood_pressure'),request.form.get('heart_rate') or None,request.form.get('respiratory_rate') or None,request.form.get('oxygen_saturation') or None,h,bmi,request.form.get('pain_scale') or None,request.form.get('observation'),session['uid'],now()));c.commit();write_audit('ENREGISTREMENT TRIAGE','TRIAGE','SUCCÈS','triage_records',cur.lastrowid);flash('Triage enregistré.','success')
 pats=c.execute('SELECT id,patient_number,last_name,first_name FROM patients ORDER BY last_name').fetchall();rows=c.execute('SELECT t.*,p.patient_number,p.last_name,p.first_name FROM triage_records t JOIN patients p ON p.id=t.patient_id ORDER BY t.id DESC LIMIT 200').fetchall();c.close()
 fields=''.join(f'<div><label>{lab}</label><input name="{n}" {"type=number step=0.1" if n in ["temperature","weight","height","oxygen_saturation"] else "type=number" if n in ["heart_rate","respiratory_rate","pain_scale"] else ""}></div>' for n,lab in [('temperature','Température'),('weight','Poids'),('blood_pressure','Tension artérielle'),('heart_rate','Fréquence cardiaque'),('respiratory_rate','Fréquence respiratoire'),('oxygen_saturation','SpO₂'),('height','Taille (cm)'),('pain_scale','Échelle douleur'),('observation','Observation')])
 body=f'''<h1>Triage</h1><div class="card"><form method="post"><input type="hidden" name="_csrf" value="{{{{csrf}}}}"><div class="formgrid"><div><label>Patient</label><select name="patient_id" required>{{% for p in pats %}}<option value="{{{{p.id}}}}">{{{{p.patient_number}}}} — {{{{p.last_name}}}} {{{{p.first_name}}}}</option>{{% endfor %}}</select></div>{fields}</div><br><button>Enregistrer</button></form></div><div class="card"><table><tr><th>Date</th><th>Patient</th><th>T°</th><th>TA</th><th>FC</th><th>FR</th><th>SpO₂</th><th>IMC</th><th>Douleur</th></tr>{{% for t in rows %}}<tr><td>{{{{t.recorded_at}}}}</td><td>{{{{t.patient_number}}}} — {{{{t.last_name}}}} {{{{t.first_name}}}}</td><td>{{{{t.temperature or ''}}}}</td><td>{{{{t.blood_pressure or ''}}}}</td><td>{{{{t.heart_rate or ''}}}}</td><td>{{{{t.respiratory_rate or ''}}}}</td><td>{{{{t.oxygen_saturation or ''}}}}</td><td>{{{{t.bmi or ''}}}}</td><td>{{{{t.pain_scale or ''}}}}</td></tr>{{% endfor %}}</table></div>'''
 return page('Triage',body,pats=pats,rows=rows)

@app.route('/consultations',methods=['GET','POST'])
@roles('Administrateur','Médecin','Infirmier','Direction')
def consultations():
 c=con()
 if request.method=='POST':
  pid=int(request.form['patient_id']);mr=c.execute('SELECT id FROM medical_records WHERE patient_id=?',(pid,)).fetchone()
  if not mr:c.execute('INSERT INTO medical_records(patient_id,created_at,updated_at) VALUES(?,?,?)',(pid,now(),now()));mr=c.execute('SELECT id FROM medical_records WHERE patient_id=?',(pid,)).fetchone()
  vals=[pid,mr['id'],session['uid'],request.form['consultation_date']]+[request.form.get(x) or None for x in ['complaint','history','temperature','weight','blood_pressure','heart_rate','respiratory_rate','oxygen_saturation','clinical_exam','primary_diagnosis','secondary_diagnosis','hypotheses','treatment','advice','next_appointment','referral']]+[1 if request.form.get('hospitalization_needed') else 0,now()]
  cur=c.execute('INSERT INTO consultations(patient_id,medical_record_id,doctor_id,consultation_date,complaint,history,temperature,weight,blood_pressure,heart_rate,respiratory_rate,oxygen_saturation,clinical_exam,primary_diagnosis,secondary_diagnosis,hypotheses,treatment,advice,next_appointment,referral,hospitalization_needed,created_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',vals);c.execute('UPDATE medical_records SET updated_at=? WHERE id=?',(now(),mr['id']));c.commit();write_audit('CRÉATION CONSULTATION','CONSULTATION','SUCCÈS','consultations',cur.lastrowid);flash('Consultation enregistrée.','success')
 pats=c.execute('SELECT id,patient_number,last_name,first_name FROM patients ORDER BY last_name').fetchall();rows=c.execute('SELECT c.*,p.patient_number,p.last_name,p.first_name,u.username FROM consultations c JOIN patients p ON p.id=c.patient_id JOIN users u ON u.id=c.doctor_id ORDER BY c.id DESC LIMIT 200').fetchall();c.close()
 def inp(n,l,ta=False):return f'<div><label>{l}</label><{"textarea" if ta else "input"} name="{n}"></{"textarea" if ta else "div"}>' if ta else f'<div><label>{l}</label><input name="{n}"></div>'
 body='''<h1>Consultations</h1><div class="card"><form method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="formgrid"><div><label>Patient</label><select name="patient_id" required>{% for p in pats %}<option value="{{p.id}}">{{p.patient_number}} — {{p.last_name}} {{p.first_name}}</option>{% endfor %}</select></div><div><label>Date</label><input name="consultation_date" type="date" required></div><div><label>Motif / plainte</label><textarea name="complaint"></textarea></div><div><label>Histoire</label><textarea name="history"></textarea></div><div><label>Examen clinique</label><textarea name="clinical_exam"></textarea></div><div><label>Diagnostic principal</label><textarea name="primary_diagnosis"></textarea></div><div><label>Diagnostic secondaire</label><textarea name="secondary_diagnosis"></textarea></div><div><label>Hypothèses</label><textarea name="hypotheses"></textarea></div><div><label>Traitement</label><textarea name="treatment"></textarea></div><div><label>Conseils</label><textarea name="advice"></textarea></div><div><label>Prochain rendez-vous</label><input name="next_appointment" type="date"></div><div><label>Référence</label><input name="referral"></div><div><label>Température</label><input name="temperature" type="number" step="0.1"></div><div><label>Poids</label><input name="weight" type="number" step="0.1"></div><div><label>TA</label><input name="blood_pressure"></div><div><label>FC</label><input name="heart_rate" type="number"></div><div><label>FR</label><input name="respiratory_rate" type="number"></div><div><label>SpO₂</label><input name="oxygen_saturation" type="number"></div></div><label><input type="checkbox" name="hospitalization_needed" style="width:auto"> Hospitalisation nécessaire</label><br><button>Enregistrer</button></form></div><div class="card"><table><tr><th>Date</th><th>Patient</th><th>Médecin</th><th>Diagnostic</th><th>Hospitalisation</th></tr>{% for c in rows %}<tr><td>{{c.consultation_date}}</td><td>{{c.patient_number}} — {{c.last_name}} {{c.first_name}}</td><td>{{c.username}}</td><td>{{c.primary_diagnosis or ''}}</td><td>{{'Oui' if c.hospitalization_needed else 'Non'}}</td></tr>{% endfor %}</table></div>'''
 return page('Consultations',body,pats=pats,rows=rows)

@app.route('/hospitalizations',methods=['GET','POST'])
@roles('Administrateur','Médecin','Infirmier','Direction')
def hospitalizations():
 c=con()
 if request.method=='POST':
  num=request.form.get('hospitalization_number') or 'H-'+datetime.now().strftime('%Y%m%d%H%M%S');cur=c.execute('INSERT INTO hospitalizations(hospitalization_number,patient_id,doctor_id,service,entry_datetime,reason,diagnosis,room_bed,treatment,observations) VALUES(?,?,?,?,?,?,?,?,?,?)',(num,request.form['patient_id'],session['uid'],request.form.get('service'),request.form.get('entry_datetime') or now(),request.form.get('reason'),request.form.get('diagnosis'),request.form.get('room_bed'),request.form.get('treatment'),request.form.get('observations')));c.commit();write_audit('CRÉATION HOSPITALISATION','HOSPITALISATION','SUCCÈS','hospitalizations',cur.lastrowid);flash('Hospitalisation enregistrée.','success')
 pats=c.execute('SELECT id,patient_number,last_name,first_name FROM patients ORDER BY last_name').fetchall();rows=c.execute('SELECT h.*,p.patient_number,p.last_name,p.first_name FROM hospitalizations h JOIN patients p ON p.id=h.patient_id ORDER BY h.id DESC LIMIT 200').fetchall();c.close()
 body='''<h1>Hospitalisation</h1><div class="card"><form method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="formgrid"><div><label>N° hospitalisation</label><input name="hospitalization_number"></div><div><label>Patient</label><select name="patient_id">{% for p in pats %}<option value="{{p.id}}">{{p.patient_number}} — {{p.last_name}} {{p.first_name}}</option>{% endfor %}</select></div><div><label>Service</label><input name="service"></div><div><label>Entrée</label><input name="entry_datetime" type="datetime-local"></div><div><label>Motif</label><input name="reason"></div><div><label>Diagnostic</label><input name="diagnosis"></div><div><label>Chambre/lit</label><input name="room_bed"></div><div><label>Traitement</label><textarea name="treatment"></textarea></div><div><label>Observations</label><textarea name="observations"></textarea></div></div><br><button>Enregistrer</button></form></div><div class="card"><table><tr><th>N°</th><th>Patient</th><th>Service</th><th>Entrée</th><th>Chambre/lit</th><th>Diagnostic</th><th>Sortie</th></tr>{% for h in rows %}<tr><td>{{h.hospitalization_number}}</td><td>{{h.patient_number}} — {{h.last_name}} {{h.first_name}}</td><td>{{h.service or ''}}</td><td>{{h.entry_datetime}}</td><td>{{h.room_bed or ''}}</td><td>{{h.diagnosis or ''}}</td><td>{{h.discharge_datetime or 'En cours'}}</td></tr>{% endfor %}</table></div>'''
 return page('Hospitalisation',body,pats=pats,rows=rows)

@app.route('/laboratory',methods=['GET','POST'])
@roles('Administrateur','Médecin','Infirmier','Direction')
def laboratory():
 c=con()
 if request.method=='POST':
  cur=c.execute('INSERT INTO laboratory_requests(patient_id,prescriber_id,exam_requested,sample,request_date) VALUES(?,?,?,?,?)',(request.form['patient_id'],session['uid'],request.form['exam_requested'],request.form.get('sample'),request.form.get('request_date') or now()));c.commit();write_audit('DEMANDE LABORATOIRE','LABORATOIRE','SUCCÈS','laboratory_requests',cur.lastrowid);flash('Demande de laboratoire enregistrée.','success')
 pats=c.execute('SELECT id,patient_number,last_name,first_name FROM patients ORDER BY last_name').fetchall();rows=c.execute('SELECT l.*,p.patient_number,p.last_name,p.first_name FROM laboratory_requests l JOIN patients p ON p.id=l.patient_id ORDER BY l.id DESC LIMIT 200').fetchall();c.close()
 body='''<h1>Laboratoire</h1><div class="card"><form method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="formgrid"><div><label>Patient</label><select name="patient_id">{% for p in pats %}<option value="{{p.id}}">{{p.patient_number}} — {{p.last_name}} {{p.first_name}}</option>{% endfor %}</select></div><div><label>Examen demandé</label><input name="exam_requested" required></div><div><label>Prélèvement</label><input name="sample"></div><div><label>Date demande</label><input name="request_date"></div><div><label>Date résultat</label><input name="result_date"></div><div><label>Résultat</label><textarea name="result"></textarea></div><div><label>Conclusion</label><textarea name="conclusion"></textarea></div></div><br><button>Enregistrer</button></form></div><div class="card"><table><tr><th>Date</th><th>Patient</th><th>Examen</th><th>Résultat</th><th>Conclusion</th></tr>{% for l in rows %}<tr><td>{{l.request_date}}</td><td>{{l.patient_number}} — {{l.last_name}} {{l.first_name}}</td><td>{{l.exam_requested}}</td><td>{{l.result or ''}}</td><td>{{l.conclusion or ''}}</td></tr>{% endfor %}</table></div>'''
 return page('Laboratoire',body,pats=pats,rows=rows)

@app.route('/pharmacy',methods=['GET','POST'])
@roles('Administrateur','Pharmacien','Médecin','Direction')
def pharmacy():
 c=con()
 if request.method=='POST':
  if request.form['action']=='medicine':
   try:
    cur=c.execute('INSERT INTO medicines(code,name,form,dosage,category,supplier,purchase_price,sale_price,available_quantity,minimum_threshold,expiration_date,lot_number,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)',(request.form['code'],request.form['name'],request.form.get('form'),request.form.get('dosage'),request.form.get('category'),request.form.get('supplier'),float(request.form.get('purchase_price') or 0),float(request.form.get('sale_price') or 0),float(request.form.get('quantity') or 0),float(request.form.get('minimum_threshold') or 0),request.form.get('expiration_date'),request.form.get('lot_number'),now(),now()));c.commit();write_audit('CRÉATION MÉDICAMENT','PHARMACIE','SUCCÈS','medicines',cur.lastrowid);flash('Médicament enregistré.','success')
   except (sqlite3.IntegrityError, PGIntegrityError):c.rollback();flash('Code médicament déjà utilisé.','danger')
  else:
   mid=int(request.form['medicine_id']);q=float(request.form['quantity']);typ=request.form['movement_type'];m=c.execute('SELECT * FROM medicines WHERE id=?',(mid,)).fetchone()
   if q<=0 or (typ!='Entrée' and m['available_quantity']<q):flash('Mouvement invalide ou stock insuffisant.','danger')
   else:
    c.execute('UPDATE medicines SET available_quantity=available_quantity+?,updated_at=? WHERE id=?',(q if typ=='Entrée' else -q,now(),mid));cur=c.execute('INSERT INTO stock_movements(medicine_id,movement_type,quantity,unit_price,reference,user_id,movement_date) VALUES(?,?,?,?,?,?,?)',(mid,typ,q,m['purchase_price'] if typ=='Entrée' else m['sale_price'],request.form.get('reference'),session['uid'],now()));c.commit();write_audit('MOUVEMENT STOCK','PHARMACIE','SUCCÈS','stock_movements',cur.lastrowid);flash('Mouvement enregistré.','success')
 meds=c.execute('SELECT * FROM medicines ORDER BY name').fetchall();moves=c.execute('SELECT s.*,m.code,m.name FROM stock_movements s JOIN medicines m ON m.id=s.medicine_id ORDER BY s.id DESC LIMIT 200').fetchall();c.close()
 body='''<h1>Pharmacie</h1><div class="card"><h3>Alertes de stock et péremption</h3>{% for m in meds %}{% if m.available_quantity<=m.minimum_threshold %}<div class="alert danger">Stock faible/rupture : {{m.code}} — {{m.name}} ({{m.available_quantity}})</div>{% endif %}{% if m.expiration_date and m.expiration_date < today %}<div class="alert danger">Produit expiré : {{m.code}} — {{m.name}} ({{m.expiration_date}})</div>{% endif %}{% endfor %}</div><div class="card"><h3>Médicament</h3><form method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="action" value="medicine"><div class="formgrid"><div><label>Code</label><input name="code" required></div><div><label>Nom</label><input name="name" required></div><div><label>Forme</label><input name="form"></div><div><label>Dosage</label><input name="dosage"></div><div><label>Catégorie</label><input name="category"></div><div><label>Fournisseur</label><input name="supplier"></div><div><label>Prix achat</label><input name="purchase_price" type="number" step="0.01"></div><div><label>Prix vente</label><input name="sale_price" type="number" step="0.01"></div><div><label>Quantité</label><input name="quantity" type="number" step="0.01"></div><div><label>Seuil minimum</label><input name="minimum_threshold" type="number" step="0.01"></div><div><label>Expiration</label><input name="expiration_date" type="date"></div><div><label>Lot</label><input name="lot_number"></div></div><br><button>Enregistrer</button></form></div><div class="card"><h3>Entrée / sortie / délivrance</h3><form method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="action" value="movement"><div class="formgrid"><div><label>Médicament</label><select name="medicine_id">{% for m in meds %}<option value="{{m.id}}">{{m.code}} — {{m.name}} ({{m.available_quantity}})</option>{% endfor %}</select></div><div><label>Type</label><select name="movement_type"><option>Entrée</option><option>Sortie</option><option>Délivrance</option></select></div><div><label>Quantité</label><input name="quantity" type="number" min="0.01" step="0.01"></div><div><label>Référence</label><input name="reference"></div></div><br><button>Enregistrer</button></form></div><div class="card"><table><tr><th>Code</th><th>Médicament</th><th>Stock</th><th>Seuil</th><th>Expiration</th><th>Lot</th></tr>{% for m in meds %}<tr><td>{{m.code}}</td><td>{{m.name}}</td><td>{{m.available_quantity}}</td><td>{{m.minimum_threshold}}</td><td>{{m.expiration_date or ''}}</td><td>{{m.lot_number or ''}}</td></tr>{% endfor %}</table></div>'''
 return page('Pharmacie',body,meds=meds,moves=moves,today=datetime.now().strftime('%Y-%m-%d'))


@app.route('/hospitalization-observations',methods=['GET','POST'])
@roles('Administrateur','Médecin','Infirmier','Direction')
def hospitalization_observations():
 c=con()
 if request.method=='POST':
  cur=c.execute('INSERT INTO hospitalization_observations(hospitalization_id,observation_datetime,temperature,blood_pressure,pulse,weight,patient_state,treatment,nurse_observation,recorded_by) VALUES(?,?,?,?,?,?,?,?,?,?)',(request.form['hospitalization_id'],request.form.get('observation_datetime') or now(),float(request.form['temperature']) if request.form.get('temperature') else None,request.form.get('blood_pressure'),float(request.form['pulse']) if request.form.get('pulse') else None,float(request.form['weight']) if request.form.get('weight') else None,request.form.get('patient_state'),request.form.get('treatment'),request.form.get('nurse_observation'),session['uid']));c.commit();write_audit('SUIVI HOSPITALISATION','HOSPITALISATION','SUCCÈS','hospitalization_observations',cur.lastrowid);flash('Observation enregistrée.','success')
 hs=c.execute("SELECT h.id,h.hospitalization_number,p.patient_number,p.last_name,p.first_name FROM hospitalizations h JOIN patients p ON p.id=h.patient_id WHERE h.discharge_datetime IS NULL ORDER BY h.id DESC").fetchall();rows=c.execute('SELECT o.*,h.hospitalization_number,p.patient_number,p.last_name,p.first_name FROM hospitalization_observations o JOIN hospitalizations h ON h.id=o.hospitalization_id JOIN patients p ON p.id=h.patient_id ORDER BY o.id DESC LIMIT 200').fetchall();c.close()
 body='''<h1>Suivi quotidien d'hospitalisation</h1><div class="card"><form method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="formgrid"><div><label>Hospitalisation</label><select name="hospitalization_id" required>{% for h in hs %}<option value="{{h.id}}">{{h.hospitalization_number}} — {{h.patient_number}} {{h.last_name}} {{h.first_name}}</option>{% endfor %}</select></div><div><label>Date/heure</label><input name="observation_datetime" type="datetime-local"></div><div><label>Température</label><input name="temperature" type="number" step="0.1"></div><div><label>TA</label><input name="blood_pressure"></div><div><label>Pouls</label><input name="pulse" type="number"></div><div><label>Poids</label><input name="weight" type="number" step="0.1"></div><div><label>État du patient</label><input name="patient_state"></div></div><label>Traitement</label><textarea name="treatment"></textarea><label>Observation infirmière/médicale</label><textarea name="nurse_observation"></textarea><br><button>Enregistrer</button></form></div><div class="card"><table><tr><th>Date</th><th>Hospitalisation</th><th>Patient</th><th>État</th><th>Observation</th></tr>{% for o in rows %}<tr><td>{{o.observation_datetime}}</td><td>{{o.hospitalization_number}}</td><td>{{o.patient_number}} — {{o.last_name}} {{o.first_name}}</td><td>{{o.patient_state or ''}}</td><td>{{o.nurse_observation or ''}}</td></tr>{% endfor %}</table></div>'''
 return page('Suivi hospitalisation',body,hs=hs,rows=rows)

@app.route('/prescriptions',methods=['GET','POST'])
@roles('Administrateur','Médecin','Direction')
def prescriptions():
 c=con()
 if request.method=='POST':
  cur=c.execute('INSERT INTO prescriptions(patient_id,consultation_id,prescribed_by,prescription_date,instructions) VALUES(?,?,?,?,?)',(request.form['patient_id'],request.form.get('consultation_id') or None,session['uid'],request.form.get('prescription_date') or now(),request.form.get('instructions')));pid=cur.lastrowid
  c.execute('INSERT INTO prescription_items(prescription_id,medicine_id,medicine_name,dosage,frequency,duration,instructions) VALUES(?,?,?,?,?,?,?)',(pid,request.form.get('medicine_id') or None,request.form['medicine_name'],request.form.get('dosage'),request.form.get('frequency'),request.form.get('duration'),request.form.get('item_instructions')));c.commit();write_audit('CRÉATION PRESCRIPTION','CONSULTATION','SUCCÈS','prescriptions',pid);flash('Prescription enregistrée.','success')
 pats=c.execute('SELECT id,patient_number,last_name,first_name FROM patients ORDER BY last_name').fetchall();meds=c.execute('SELECT id,name,dosage FROM medicines ORDER BY name').fetchall();rows=c.execute('SELECT p.*,pt.patient_number,pt.last_name,pt.first_name,u.username,pi.medicine_name,pi.dosage,pi.frequency,pi.duration FROM prescriptions p JOIN patients pt ON pt.id=p.patient_id JOIN users u ON u.id=p.prescribed_by LEFT JOIN prescription_items pi ON pi.prescription_id=p.id ORDER BY p.id DESC LIMIT 200').fetchall();c.close()
 body='''<h1>Prescriptions</h1><div class="card"><form method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="formgrid"><div><label>Patient</label><select name="patient_id" required>{% for p in pats %}<option value="{{p.id}}">{{p.patient_number}} — {{p.last_name}} {{p.first_name}}</option>{% endfor %}</select></div><div><label>Médicament</label><select name="medicine_id"><option value="">Saisie libre</option>{% for m in meds %}<option value="{{m.id}}">{{m.name}} {{m.dosage or ''}}</option>{% endfor %}</select></div><div><label>Nom du médicament</label><input name="medicine_name" required></div><div><label>Dosage</label><input name="dosage"></div><div><label>Fréquence / posologie</label><input name="frequency"></div><div><label>Durée</label><input name="duration"></div><div><label>Date</label><input name="prescription_date" type="date"></div></div><label>Instructions</label><textarea name="item_instructions"></textarea><label>Instructions générales</label><textarea name="instructions"></textarea><br><button>Enregistrer</button></form></div><div class="card"><table><tr><th>Date</th><th>Patient</th><th>Médicament</th><th>Dosage</th><th>Posologie</th><th>Durée</th></tr>{% for r in rows %}<tr><td>{{r.prescription_date}}</td><td>{{r.patient_number}} — {{r.last_name}} {{r.first_name}}</td><td>{{r.medicine_name}}</td><td>{{r.dosage or ''}}</td><td>{{r.frequency or ''}}</td><td>{{r.duration or ''}}</td></tr>{% endfor %}</table></div>'''
 return page('Prescriptions',body,pats=pats,meds=meds,rows=rows)

@app.route('/inventory',methods=['GET','POST'])
@roles('Administrateur','Pharmacien','Direction')
def inventory():
 c=con()
 if request.method=='POST':
  mid=int(request.form['medicine_id']);m=c.execute('SELECT available_quantity FROM medicines WHERE id=?',(mid,)).fetchone();theo=float(m['available_quantity']);count=float(request.form['counted_quantity']);cur=c.execute('INSERT INTO inventory(inventory_date,medicine_id,theoretical_quantity,counted_quantity,difference,user_id) VALUES(?,?,?,?,?,?)',(request.form.get('inventory_date') or now(),mid,theo,count,count-theo,session['uid']));c.commit();write_audit('INVENTAIRE','PHARMACIE','SUCCÈS','inventory',cur.lastrowid);flash('Inventaire enregistré.','success')
 meds=c.execute('SELECT id,code,name,available_quantity FROM medicines ORDER BY name').fetchall();rows=c.execute('SELECT i.*,m.code,m.name FROM inventory i JOIN medicines m ON m.id=i.medicine_id ORDER BY i.id DESC LIMIT 200').fetchall();c.close()
 body='''<h1>Inventaire</h1><div class="card"><form method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="formgrid"><div><label>Médicament</label><select name="medicine_id" required>{% for m in meds %}<option value="{{m.id}}">{{m.code}} — {{m.name}} ({{m.available_quantity}})</option>{% endfor %}</select></div><div><label>Quantité comptée</label><input name="counted_quantity" type="number" step="0.01" required></div><div><label>Date</label><input name="inventory_date" type="datetime-local"></div></div><br><button>Enregistrer</button></form></div><div class="card"><table><tr><th>Date</th><th>Médicament</th><th>Théorique</th><th>Compté</th><th>Écart</th></tr>{% for r in rows %}<tr><td>{{r.inventory_date}}</td><td>{{r.code}} — {{r.name}}</td><td>{{r.theoretical_quantity}}</td><td>{{r.counted_quantity}}</td><td>{{r.difference}}</td></tr>{% endfor %}</table></div>'''
 return page('Inventaire',body,meds=meds,rows=rows)


@app.route('/medical-forms',methods=['GET','POST'])
@roles('Administrateur','Médecin','Infirmier','Direction')
def medical_forms():
 c=con()
 if request.method=='POST':
  a=request.form['action']; pid=request.form['patient_id']
  if a=='discharge':
   cur=c.execute('INSERT INTO discharges(patient_id,hospitalization_id,diagnosis,evolution,treatment,recommendations,discharge_date,user_id) VALUES(?,?,?,?,?,?,?,?)',(pid,request.form.get('hospitalization_id') or None,request.form.get('diagnosis'),request.form.get('evolution'),request.form.get('treatment'),request.form.get('recommendations'),request.form.get('discharge_date') or now(),session['uid']))
   if request.form.get('hospitalization_id'): c.execute('UPDATE hospitalizations SET discharge_datetime=?,final_diagnosis=?,recommendations=? WHERE id=?',(request.form.get('discharge_date') or now(),request.form.get('diagnosis'),request.form.get('recommendations'),request.form['hospitalization_id']))
  elif a=='referral': cur=c.execute('INSERT INTO referrals(patient_id,destination,reason,clinical_summary,recommendations,referral_date,user_id) VALUES(?,?,?,?,?,?,?)',(pid,request.form['destination'],request.form.get('reason'),request.form.get('clinical_summary'),request.form.get('recommendations'),request.form.get('referral_date') or now(),session['uid']))
  else: cur=c.execute('INSERT INTO follow_ups(patient_id,care_type,observation,evolution,follow_up_date,user_id) VALUES(?,?,?,?,?,?)',(pid,request.form.get('care_type'),request.form.get('observation'),request.form.get('evolution'),request.form.get('follow_up_date') or now(),session['uid']))
  c.commit(); write_audit('FORMULAIRE MEDICAL','CONSULTATION','SUCCÈS',a,cur.lastrowid); flash('Formulaire enregistré.','success')
 pats=c.execute('SELECT id,patient_number,last_name,first_name FROM patients ORDER BY last_name').fetchall(); hs=c.execute('SELECT id,hospitalization_number,patient_id FROM hospitalizations WHERE discharge_datetime IS NULL ORDER BY id DESC').fetchall(); c.close()
 body='''<h1>Autres formulaires médicaux</h1><div class="card"><form method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="formgrid"><div><label>Type</label><select name="action"><option value="discharge">Sortie / discharge</option><option value="referral">Référence</option><option value="follow_up">Suivi</option></select></div><div><label>Patient</label><select name="patient_id" required>{% for p in pats %}<option value="{{p.id}}">{{p.patient_number}} — {{p.last_name}} {{p.first_name}}</option>{% endfor %}</select></div><div><label>Hospitalisation (sortie)</label><select name="hospitalization_id"><option value="">Aucune</option>{% for h in hs %}<option value="{{h.id}}">{{h.hospitalization_number}}</option>{% endfor %}</select></div><div><label>Destination (référence)</label><input name="destination"></div><div><label>Type de prise en charge (suivi)</label><input name="care_type"></div><div><label>Date</label><input name="discharge_date" type="datetime-local"></div></div><label>Diagnostic</label><textarea name="diagnosis"></textarea><label>Évolution / observation</label><textarea name="evolution"></textarea><label>Résumé clinique / observation</label><textarea name="clinical_summary"></textarea><label>Traitement</label><textarea name="treatment"></textarea><label>Motif</label><textarea name="reason"></textarea><label>Recommandations</label><textarea name="recommendations"></textarea><label>Observation de suivi</label><textarea name="observation"></textarea><br><button>Enregistrer</button></form></div>'''
 return page('Formulaires médicaux',body,pats=pats,hs=hs)

@app.route('/backup')
@roles('Administrateur')
def backup():
 import shutil
 target=BASE/f"backup_clinique_{datetime.now().strftime('%Y%m%d_%H%M%S')}.db"
 
 if is_postgres():
  flash('En production PostgreSQL, utilisez le script pg_dump fourni dans la livraison pour les sauvegardes.', 'warning'); return redirect(url_for('administration'))
 src=con(); dest=sqlite3.connect(target); src.backup(dest); dest.close(); src.close(); write_audit('SAUVEGARDE BASE','ADMINISTRATION','SUCCÈS','database',None); return send_file(target,as_attachment=True,download_name=target.name)

@app.route('/accounting',methods=['GET','POST'])
@roles('Administrateur','Comptable','Direction')
def accounting():
 c=con()
 if request.method=='POST':
  a=request.form['action']
  if a=='invoice':
   n=request.form.get('invoice_number') or 'FAC-'+datetime.now().strftime('%Y%m%d%H%M%S');cur=c.execute('INSERT INTO invoices(patient_id,invoice_number,reason,amount,status,created_at) VALUES(?,?,?,?,?,?)',(request.form.get('patient_id') or None,n,request.form['reason'],float(request.form['amount']),request.form.get('status') or 'À payer',now()));c.commit();write_audit('CRÉATION FACTURE','COMPTABILITÉ','SUCCÈS','invoices',cur.lastrowid);flash('Facture enregistrée.','success')
  elif a=='payment':
   cur=c.execute('INSERT INTO payments(invoice_id,patient_id,amount,payment_mode,reason,user_id,payment_date) VALUES(?,?,?,?,?,?,?)',(request.form.get('invoice_id') or None,request.form.get('patient_id') or None,float(request.form['amount']),request.form['payment_mode'],request.form.get('reason'),session['uid'],now()));c.commit();write_audit('PAIEMENT','COMPTABILITÉ','SUCCÈS','payments',cur.lastrowid);flash('Paiement enregistré.','success')
  elif a=='cash_close':
   cur=c.execute('INSERT INTO cash_transactions(transaction_type,amount,reason,user_id,transaction_date) VALUES(?,?,?,?,?)',('Clôture',float(request.form['amount']),request.form['reason'],session['uid'],now()));c.commit();write_audit('CLÔTURE DE CAISSE','COMPTABILITÉ','SUCCÈS','cash_transactions',cur.lastrowid);flash('Clôture de caisse enregistrée.','success')
  else:
   cur=c.execute('INSERT INTO expenses(reason,amount,supplier,user_id,expense_date) VALUES(?,?,?,?,?)',(request.form['reason'],float(request.form['amount']),request.form.get('supplier'),session['uid'],request.form.get('expense_date') or now()));c.commit();write_audit('DÉPENSE','COMPTABILITÉ','SUCCÈS','expenses',cur.lastrowid);flash('Dépense enregistrée.','success')
 pats=c.execute('SELECT id,patient_number,last_name,first_name FROM patients ORDER BY last_name').fetchall();inv=c.execute('SELECT * FROM invoices ORDER BY id DESC LIMIT 100').fetchall();c.close()
 body='''<h1>Comptabilité</h1><div class="card"><h3>Facture</h3><form method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="action" value="invoice"><div class="formgrid"><div><label>Patient</label><select name="patient_id"><option value="">Sans patient</option>{% for p in pats %}<option value="{{p.id}}">{{p.patient_number}} — {{p.last_name}} {{p.first_name}}</option>{% endfor %}</select></div><div><label>N° facture</label><input name="invoice_number"></div><div><label>Motif</label><input name="reason" required></div><div><label>Montant</label><input name="amount" type="number" step="0.01" required></div></div><br><button>Enregistrer</button></form></div><div class="card"><h3>Paiement</h3><form method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="action" value="payment"><div class="formgrid"><div><label>Patient</label><select name="patient_id"><option value="">Sans patient</option>{% for p in pats %}<option value="{{p.id}}">{{p.patient_number}} — {{p.last_name}} {{p.first_name}}</option>{% endfor %}</select></div><div><label>ID facture (optionnel)</label><input name="invoice_id"></div><div><label>Montant</label><input name="amount" type="number" step="0.01" required></div><div><label>Mode de paiement</label><input name="payment_mode" required></div><div><label>Motif</label><input name="reason"></div></div><br><button>Enregistrer</button></form></div><div class="card"><h3>Dépense</h3><form method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="action" value="expense"><div class="formgrid"><div><label>Motif</label><input name="reason" required></div><div><label>Montant</label><input name="amount" type="number" step="0.01" required></div><div><label>Fournisseur</label><input name="supplier"></div><div><label>Date</label><input name="expense_date"></div></div><br><button>Enregistrer</button></form></div><div class="card"><h3>Clôture de caisse</h3><form method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="action" value="cash_close"><div class="formgrid"><div><label>Montant de clôture</label><input name="amount" type="number" step="0.01" required></div><div><label>Motif</label><input name="reason" required></div></div><br><button>Enregistrer la clôture</button></form></div><div class="card"><h3>Créances / factures à payer</h3>{% for i in inv %}{% if i.status != 'Payée' %}<div>{{i.invoice_number}} — {{i.reason}} — {{i.amount}} — {{i.status}}</div>{% endif %}{% endfor %}</div><div class="card"><table><tr><th>N°</th><th>Motif</th><th>Montant</th><th>Statut</th></tr>{% for i in inv %}<tr><td>{{i.invoice_number}}</td><td>{{i.reason}}</td><td>{{i.amount}}</td><td>{{i.status}}</td></tr>{% endfor %}</table></div>'''
 return page('Comptabilité',body,pats=pats,inv=inv)

@app.route('/administration',methods=['GET','POST'])
@roles('Administrateur')
def administration():
 c=con()
 if request.method=='POST':
  if request.form['action']=='create':
   rid=c.execute('SELECT id FROM roles WHERE name=?',(request.form['role'],)).fetchone()['id'];t=now()
   try:cur=c.execute('INSERT INTO users(username,password_hash,role_id,created_at,updated_at) VALUES(?,?,?,?,?)',(request.form['username'],generate_password_hash(request.form['password']),rid,t,t));c.commit();write_audit('CRÉATION UTILISATEUR','ADMINISTRATION','SUCCÈS','users',cur.lastrowid);flash('Utilisateur créé.','success')
   except (sqlite3.IntegrityError, PGIntegrityError):c.rollback();flash('Nom d’utilisateur déjà utilisé.','danger')
  else:
   uid=int(request.form['user_id']);c.execute('UPDATE users SET is_active=CASE WHEN is_active THEN FALSE ELSE TRUE END,updated_at=? WHERE id=?',(now(),uid));c.commit();write_audit('ACTIVATION/DÉSACTIVATION','ADMINISTRATION','SUCCÈS','users',uid);flash('État modifié.','success')
 users=c.execute('SELECT u.*,r.name role FROM users u JOIN roles r ON r.id=u.role_id ORDER BY username').fetchall();c.close()
 body='''<h1>Administration</h1><div class="card"><form method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="action" value="create"><div class="formgrid"><div><label>Utilisateur</label><input name="username" required></div><div><label>Mot de passe</label><input name="password" type="password" required></div><div><label>Rôle</label><select name="role">{% for r in roles %}<option>{{r}}</option>{% endfor %}</select></div></div><br><button>Créer</button></form></div><div class="card"><table><tr><th>Utilisateur</th><th>Rôle</th><th>Actif</th><th>Action</th></tr>{% for u in users %}<tr><td>{{u.username}}</td><td>{{u.role}}</td><td>{{'Oui' if u.is_active else 'Non'}}</td><td>{% if u.id!=user.id %}<form method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="action" value="toggle"><input type="hidden" name="user_id" value="{{u.id}}"><button>Changer</button></form>{% endif %}</td></tr>{% endfor %}</table></div>'''
 return page('Administration',body,users=users,roles=ROLES)

@app.route('/audit')
@roles('Administrateur')
def audit():
 c=con();rows=c.execute('SELECT a.*,u.username FROM audit_logs a LEFT JOIN users u ON u.id=a.user_id ORDER BY a.id DESC LIMIT 500').fetchall();c.close();body='''<h1>Journal d’audit</h1><div class="card"><table><tr><th>Date/heure</th><th>Utilisateur</th><th>Action</th><th>Module</th><th>Objet</th><th>ID</th><th>Résultat</th></tr>{% for a in rows %}<tr><td>{{a.date_time}}</td><td>{{a.username or 'Système'}}</td><td>{{a.action}}</td><td>{{a.module}}</td><td>{{a.object_type or ''}}</td><td>{{a.object_id or ''}}</td><td>{{a.result}}</td></tr>{% endfor %}</table></div>''';return page('Audit',body,rows=rows)

@app.route('/reports/pdf')
@roles('Administrateur','Direction')
def reports_pdf():
 from reportlab.lib.pagesizes import A4
 from reportlab.pdfgen import canvas
 target=BASE/f"rapport_clinique_{datetime.now().strftime('%Y%m%d_%H%M%S')}.pdf"
 cdb=con(); data=[
  ('Patients',cdb.execute('SELECT COUNT(*) FROM patients').fetchone()[0]),
  ('Consultations',cdb.execute('SELECT COUNT(*) FROM consultations').fetchone()[0]),
  ('Hospitalisations',cdb.execute('SELECT COUNT(*) FROM hospitalizations').fetchone()[0]),
  ('Rendez-vous',cdb.execute('SELECT COUNT(*) FROM appointments').fetchone()[0]),
  ('Recettes',cdb.execute('SELECT COALESCE(SUM(amount),0) FROM payments').fetchone()[0]),
  ('Dépenses',cdb.execute('SELECT COALESCE(SUM(amount),0) FROM expenses').fetchone()[0]),
  ('Stocks faibles',cdb.execute('SELECT COUNT(*) FROM medicines WHERE available_quantity<=minimum_threshold').fetchone()[0])
 ]; cdb.close()
 pdf=canvas.Canvas(str(target),pagesize=A4); pdf.setTitle(APP+' - Rapport'); y=800
 pdf.setFont('Helvetica-Bold',16); pdf.drawString(50,y,APP); y-=28
 pdf.setFont('Helvetica',11); pdf.drawString(50,y,'Rapport synthétique'); y-=30
 for label,value in data:
  pdf.drawString(60,y,f'{label}: {value}'); y-=20
 pdf.drawString(50,y,f'Généré le {now()}'); pdf.save()
 write_audit('EXPORT PDF','ADMINISTRATION','SUCCÈS','report',None)
 return send_file(target,as_attachment=True,download_name=target.name)

@app.route('/reports')
@roles('Administrateur','Direction')
def reports():
 c=con();d={'patients':c.execute('SELECT COUNT(*) FROM patients').fetchone()[0],'consultations':c.execute('SELECT COUNT(*) FROM consultations').fetchone()[0],'hospitalisations':c.execute('SELECT COUNT(*) FROM hospitalizations').fetchone()[0],'rendez_vous':c.execute('SELECT COUNT(*) FROM appointments').fetchone()[0],'recettes':c.execute('SELECT COALESCE(SUM(amount),0) FROM payments').fetchone()[0],'depenses':c.execute('SELECT COALESCE(SUM(amount),0) FROM expenses').fetchone()[0],'stocks_faibles':c.execute('SELECT COUNT(*) FROM medicines WHERE available_quantity<=minimum_threshold').fetchone()[0]};c.close();body='''<h1>Rapports / statistiques</h1><div class="grid">{% for k,v in data.items() %}<div class="card"><div class="small">{{k.replace('_',' ')|upper}}</div><div class="stat">{{v}}</div></div>{% endfor %}</div><div class="card"><button onclick="window.print()">Imprimer</button> <a class="btn" href="{{url_for('reports_pdf')}}">Exporter PDF</a></div>''';return page('Rapports',body,data=d)

@app.errorhandler(403)
def e403(e):return page('Accès refusé','<div class="card"><h1>Accès refusé</h1><p>Votre rôle ne permet pas cette opération.</p></div>'),403
@app.errorhandler(400)
def e400(e):return page('Requête invalide','<div class="card"><h1>Requête invalide</h1><p>Le contrôle de sécurité a rejeté la demande.</p></div>'),400
if __name__=='__main__':
 init_db();print(f'{APP} : http://127.0.0.1:5000');app.run(host=os.getenv('CLINIQUE_HOST','127.0.0.1'),port=int(os.getenv('CLINIQUE_PORT','5000')),debug=False)
